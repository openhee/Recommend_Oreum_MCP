NGROK_AUTHTOKEN="여기에_ngrok_authtoken_입력"

# /view 지도 페이지(카카오맵)에서 쓰는 JS 키. 카카오 개발자 콘솔 > 내 애플리케이션 >
# 앱 키 > JavaScript 키. 이 값을 서빙할 도메인(예: 아래 OREUM_MCP_PUBLIC_URL)을
# 카카오 개발자 콘솔의 Web 플랫폼 도메인에도 등록해야 지도가 뜬다.
KAKAO_JS_KEY="여기에_카카오_JavaScript_키_입력"

# 필요하면 포트도 여기서 바꿀 수 있습니다 (기본값 11010).
# OREUM_MCP_PORT=11010

# recommend_oreum이 반환하는 map_url(추천 오름 지도 보기 페이지)에 쓸, 이
# 서버의 외부 공개 주소. ngrok 대시보드(http://localhost:4041)에서 발급된
# 주소를 확인해 채워 넣으세요. 비워두면 http://localhost:$OREUM_MCP_PORT로
# 대체되어 컨테이너 밖(다른 사람의 MCP 클라이언트)에서는 열리지 않습니다.
# OREUM_MCP_PUBLIC_URL=https://xxxx.ngrok-free.app
